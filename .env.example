# Copy to the plugin's state directory as .env, then fill in.
# Default location: ~/.local/state/telegram-plugin/.env
# Anything already exported in the environment wins over this file.

# Both are required. Create an application at https://my.telegram.org to get them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional overrides, shown with their defaults:
# TELEGRAM_STATE_DIR=~/.local/state/telegram-plugin
# TELEGRAM_SESSION_NAME=telegram
# TELEGRAM_OUTPUT_ROOT=$TELEGRAM_STATE_DIR/downloads
# TELEGRAM_PLUGIN_PYTHON=

# Set to exactly 1 to register the send_message tool. Absent means no send tool at all.
# This is an escalation: an agent can then send messages from your account, under
# your name, to anyone it can reach, and nothing can un-send them. Prefer setting
# it per-session in the environment over enabling it here.
# TELEGRAM_PLUGIN_ALLOW_SEND=
