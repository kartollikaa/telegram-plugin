#!/bin/sh
exec 3>&1 1>&2
set -e

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
STATE=${TELEGRAM_STATE_DIR:-"$HOME/.local/state/telegram-plugin"}
DEPS="telethon>=1.42,<2"

mkdir -p "$STATE"
chmod 700 "$STATE"

VENV="$STATE/venv"
STAMP="$VENV/.deps-stamp"
LOCKDIR="$STATE/.install.lock"

digest() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1
    elif command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    else
        printf '%s' "$1" | cksum | cut -d' ' -f1
    fi
}

VERSION=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$ROOT/pyproject.toml" | head -1)
WANTED=$(digest "$DEPS|$VERSION")

has_dependencies() {
    "$1" -c 'import telethon' >/dev/null 2>&1 3>&-
}

refuse_to_delete_a_non_venv() {
    if [ -e "$1" ] && [ ! -f "$1/pyvenv.cfg" ]; then
        echo "[telegram-plugin] refusing to delete $1: no pyvenv.cfg, so it is not a" >&2
        echo "[telegram-plugin] virtualenv this plugin created. Check TELEGRAM_STATE_DIR." >&2
        exit 1
    fi
}

cleanup_install() {
    # The staging venv is ~27MB. Every exit after mktemp but before the mv --
    # a failed pip, or the refusal to delete a non-venv -- used to leak one.
    if [ -n "${STAGE:-}" ] && [ -d "$STAGE" ]; then
        rm -rf "$STAGE"
    fi
    rmdir "$LOCKDIR" 2>/dev/null || true
}

acquire_install_lock() {
    waited=0
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        waited=$((waited + 1))
        if [ "$waited" -gt 600 ]; then
            echo "[telegram-plugin] another process has been installing for 10 minutes;" >&2
            echo "[telegram-plugin] remove $LOCKDIR if that process is gone." >&2
            exit 1
        fi
        sleep 1
    done
    trap cleanup_install EXIT INT TERM
}

install_into() {
    "$1" -m pip install --quiet --disable-pip-version-check --upgrade pip >&2 3>&-
    # shellcheck disable=SC2086
    "$1" -m pip install --quiet --disable-pip-version-check $DEPS >&2 3>&-
}

if [ -n "${TELEGRAM_PLUGIN_PYTHON:-}" ]; then
    PYTHON=$TELEGRAM_PLUGIN_PYTHON
    if ! has_dependencies "$PYTHON"; then
        echo "[telegram-plugin] TELEGRAM_PLUGIN_PYTHON=$PYTHON cannot import telethon." >&2
        echo "[telegram-plugin] Install them there:" >&2
        echo "[telegram-plugin]   $PYTHON -m pip install $DEPS" >&2
        echo "[telegram-plugin] or unset the variable and let the plugin build its own." >&2
        exit 1
    fi
else
    PYTHON="$VENV/bin/python"
    if [ ! -x "$PYTHON" ] ||
        [ "$(cat "$STAMP" 2>/dev/null)" != "$WANTED" ] ||
        ! has_dependencies "$PYTHON"; then
        acquire_install_lock
        if [ ! -x "$PYTHON" ] ||
            [ "$(cat "$STAMP" 2>/dev/null)" != "$WANTED" ] ||
            ! has_dependencies "$PYTHON"; then
            echo "[telegram-plugin] installing dependencies into $VENV" >&2
            STAGE=$(mktemp -d "$STATE/venv.XXXXXX")
            if ! python3 -m venv "$STAGE" 3>&-; then
                rm -rf "$STAGE"
                echo "[telegram-plugin] cannot create a virtualenv: python3 -m venv failed." >&2
                echo "[telegram-plugin] On Debian/Ubuntu install python3-venv, or point" >&2
                echo "[telegram-plugin] TELEGRAM_PLUGIN_PYTHON at an interpreter that has:" >&2
                echo "[telegram-plugin]   $DEPS" >&2
                exit 1
            fi
            install_into "$STAGE/bin/python"
            printf '%s' "$WANTED" >"$STAGE/.deps-stamp"
            refuse_to_delete_a_non_venv "$VENV"
            rm -rf "$VENV"
            mv "$STAGE" "$VENV"
        fi
        rmdir "$LOCKDIR" 2>/dev/null || true
        trap - EXIT INT TERM
    fi
fi

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "$PYTHON" -m telegram_plugin.cli "$@" 1>&3 3>&-
