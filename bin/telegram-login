#!/bin/sh
# The login. Talks to a human, so stdout stays as it is.
set -e
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
STATE=${TELEGRAM_STATE_DIR:-"$HOME/.local/state/telegram-plugin"}
VENV="$STATE/venv"

# --status and --wait only read, and have to answer where the state directory cannot
# be written, such as an agent's sandbox. Everything else goes through bin/telegram's
# installer first, so a runtime built before a dependency was added gets it now.
needs_runtime=1
for argument in "$@"; do
    case $argument in
        --status | --wait) needs_runtime=0 ;;
    esac
done
if [ -z "${TELEGRAM_PLUGIN_PYTHON:-}" ] && [ ! -x "$VENV/bin/python" ]; then
    needs_runtime=1
fi
if [ "$needs_runtime" = 1 ] && ! "$ROOT/bin/telegram" --help >/dev/null; then
    # Someone may be waiting on the status file; a failure that only reached stderr
    # would leave them reading a stale one.
    HINT="the plugin runtime could not be installed; the reason is in the terminal above"
    STATUS="$STATE/auth-status.json"
    {
        printf '{"state": "failed", "hint": "%s", "pid": %s, "written": "%s"}\n' \
            "$HINT" "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" >"$STATUS" &&
            chmod 600 "$STATUS"
    } 2>/dev/null || true
    echo "✗ The plugin runtime could not be installed (see above). Nothing was logged in." >&2
    exit 1
fi

if [ -n "${TELEGRAM_PLUGIN_PYTHON:-}" ]; then
    PYTHON=$TELEGRAM_PLUGIN_PYTHON
else
    PYTHON="$VENV/bin/python"
fi

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$PYTHON" -m telegram_plugin.login "$@"
