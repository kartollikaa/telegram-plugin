#!/bin/sh
# Universal entry point: any MCP host can point at this file.
#
# Stdout is the MCP channel and must carry nothing else, so we stash the real
# stdout on fd 3 and route our own chatter — including pip's — to stderr.
exec 3>&1 1>&2
set -e

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
STATE=${TELEGRAM_STATE_DIR:-"$HOME/.local/state/telegram-plugin"}
DEPS="telethon>=1.36 mcp>=2,<3"

mkdir -p "$STATE"
chmod 700 "$STATE"

VENV="$STATE/venv"
STAMP="$VENV/.deps-sha"

digest() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1
    elif command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    else
        printf '%s' "$1" | cksum | cut -d' ' -f1
    fi
}

install_into() {
    "$1" -m pip install --quiet --disable-pip-version-check --upgrade pip
    # Word splitting is what we want here: DEPS is a list of requirements.
    # shellcheck disable=SC2086
    "$1" -m pip install --quiet --disable-pip-version-check $DEPS
}

WANTED=$(digest "$DEPS")

if [ -n "${TELEGRAM_PLUGIN_PYTHON:-}" ]; then
    PYTHON=$TELEGRAM_PLUGIN_PYTHON
elif [ -x "$VENV/bin/python" ]; then
    PYTHON="$VENV/bin/python"
    if [ "$(cat "$STAMP" 2>/dev/null)" != "$WANTED" ]; then
        echo "[telegram-plugin] dependency list changed, updating $VENV" >&2
        install_into "$PYTHON"
        printf '%s' "$WANTED" >"$STAMP"
    fi
else
    echo "[telegram-plugin] installing dependencies into $VENV (first run only)" >&2
    rm -rf "$VENV.tmp"
    if ! python3 -m venv "$VENV.tmp"; then
        echo "[telegram-plugin] cannot create a virtualenv: python3 -m venv failed." >&2
        echo "[telegram-plugin] On Debian/Ubuntu install python3-venv, or set" >&2
        echo "[telegram-plugin] TELEGRAM_PLUGIN_PYTHON to an interpreter that already has:" >&2
        echo "[telegram-plugin]   $DEPS" >&2
        exit 1
    fi
    install_into "$VENV.tmp/bin/python"
    printf '%s' "$WANTED" >"$VENV.tmp/.deps-sha"
    rm -rf "$VENV"
    mv "$VENV.tmp" "$VENV"
    PYTHON="$VENV/bin/python"
fi

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "$PYTHON" -m telegram_plugin.server 1>&3 3>&-
